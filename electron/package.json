{
  "name": "ecorean-boc-electron",
  "version": "0.4.4",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "cross-env ECOREAN_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "start": "electron .",
    "build:ui": "npm --prefix ../ui run build && node scripts/copy-ui-dist.js",
    "db:init": "node --experimental-sqlite scripts/init-sqlite.js",
    "db:register-first-project": "node --experimental-sqlite scripts/register-first-operating-project.js",
    "smoke:prod": "cross-env ECOREAN_SMOKE_TEST=1 electron .",
    "smoke:release": "node -e \"const path=require('path'); process.chdir('..'); require(path.join(process.cwd(),'tests','release-candidate.smoke.js'))\"",
    "smoke:release:diagnose": "node ../tests/v0-4-5-release-smoke-diagnostics.js",
    "smoke:release:timed": "node -e \"const {performance}=require('perf_hooks'); const {spawnSync}=require('child_process'); const started=performance.now(); const result=spawnSync(process.execPath,['../tests/v0-4-5-release-smoke-diagnostics.js'],{stdio:'inherit',env:{...process.env,BOC_RELEASE_SMOKE_TIMEOUT_MS:process.env.BOC_RELEASE_SMOKE_TIMEOUT_MS||'30000'}}); const elapsed=Math.round(performance.now()-started); console.log(JSON.stringify({script:'smoke:release:timed',duration_ms:elapsed,exit_code:result.status,signal:result.signal},null,2)); process.exit(result.status||0);\"",
    "qa:v0.4.6:visual-click": "node ../tests/v0-4-6-packaged-visual-click.smoke.js",
    "qa:v0.4.6:screenshot": "node ../tests/v0-4-6-safe-screenshot-harness.smoke.js",
    "qa:v0.4.6:output-typography": "node ../tests/v0-4-6-output-typography-render.smoke.js",
    "qa:v0.4.6:all": "npm run qa:v0.4.6:visual-click && npm run qa:v0.4.6:screenshot && npm run qa:v0.4.6:output-typography",
    "qa:v0.5.0:roles": "node ../tests/v0-5-0-user-roles-permissions.smoke.js",
    "qa:v0.5.0:customer-guard": "node ../tests/v0-5-0-customer-data-guard.smoke.js",
    "qa:v0.5.0:route-guard": "node ../tests/v0-5-0-route-guard.smoke.js",
    "qa:v0.5.0:output-guard": "node ../tests/v0-5-0-output-permission-guard.smoke.js",
    "qa:v0.5.0:all": "npm run qa:v0.5.0:roles && npm run qa:v0.5.0:customer-guard && npm run qa:v0.5.0:route-guard && npm run qa:v0.5.0:output-guard",
    "dist": "npm run build:ui && electron-builder --win --x64 --dir",
    "dist:installer": "npm run build:ui && electron-builder --win --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ecorean.boc",
    "productName": "ECOREAN BOC CEO Dashboard",
    "files": [
      "main.js",
      "preload.js",
      "services/**/*",
      "build/icon.ico",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": "nsis"
    }
  }
}
