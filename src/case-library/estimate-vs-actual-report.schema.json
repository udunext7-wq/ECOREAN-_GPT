{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "0.1-estimate-vs-actual-report",
  "title": "ECOREAN Estimate vs Actual Report",
  "type": "object",
  "required": [
    "projectId",
    "estimateId",
    "estimatedCost",
    "actualCost",
    "costVariance",
    "costVarianceRate",
    "estimatedDuration",
    "actualDuration",
    "durationVariance",
    "varianceReasons",
    "underestimatedItems",
    "overestimatedItems",
    "missingProcesses",
    "unnecessaryProcesses",
    "supplierIssues",
    "laborIssues",
    "scheduleIssues",
    "defectIssues",
    "correctionCandidates",
    "recommendedMasterDbUpdates"
  ],
  "properties": {
    "projectId": {"type": "string"},
    "estimateId": {"type": "string"},
    "estimatedCost": {"type": ["number", "string"]},
    "actualCost": {"type": ["number", "string"]},
    "costVariance": {"type": ["number", "string"]},
    "costVarianceRate": {"type": ["number", "string"]},
    "estimatedDuration": {"type": ["number", "string"]},
    "actualDuration": {"type": ["number", "string"]},
    "durationVariance": {"type": ["number", "string"]},
    "varianceReasons": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "underestimatedItems": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "overestimatedItems": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "missingProcesses": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "unnecessaryProcesses": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "supplierIssues": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "laborIssues": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "scheduleIssues": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "defectIssues": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "correctionCandidates": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "recommendedMasterDbUpdates": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  }
}

