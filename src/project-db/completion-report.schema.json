{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "0.1-completion-report",
  "title": "ECOREAN Project Completion Report",
  "type": "object",
  "required": [
    "projectId",
    "completionDate",
    "finalScope",
    "finalContractAmount",
    "finalAdditionalWorkAmount",
    "actualMaterialCost",
    "actualLaborCost",
    "actualSubcontractCost",
    "actualEquipmentCost",
    "actualWasteCost",
    "actualTransportCost",
    "actualDuration",
    "delayReasons",
    "defects",
    "claims",
    "clientFeedback",
    "finalMargin",
    "lessonsLearned",
    "photos",
    "managerNotes"
  ],
  "properties": {
    "projectId": {"type": "string"},
    "completionDate": {"type": "string"},
    "finalScope": {"type": "object", "additionalProperties": true},
    "finalContractAmount": {"type": ["number", "string"]},
    "finalAdditionalWorkAmount": {"type": ["number", "string"]},
    "actualMaterialCost": {"type": ["number", "string"]},
    "actualLaborCost": {"type": ["number", "string"]},
    "actualSubcontractCost": {"type": ["number", "string"]},
    "actualEquipmentCost": {"type": ["number", "string"]},
    "actualWasteCost": {"type": ["number", "string"]},
    "actualTransportCost": {"type": ["number", "string"]},
    "actualDuration": {"type": ["number", "string"]},
    "delayReasons": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "defects": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "claims": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "clientFeedback": {"type": "object", "additionalProperties": true},
    "finalMargin": {"type": ["number", "string"]},
    "lessonsLearned": {"type": "array", "items": {"type": "string"}},
    "photos": {"type": "array", "items": {"type": "string"}},
    "managerNotes": {"type": "string"}
  }
}

