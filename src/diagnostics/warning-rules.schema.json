{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "0.1-warning-rules",
  "title": "ECOREAN Warning Rules Schema",
  "type": "object",
  "required": ["warningId", "warningName", "condition", "warningMessage", "severity", "continueAllowed"],
  "properties": {
    "warningId": {"type": "string"},
    "warningName": {"type": "string"},
    "condition": {"type": "object", "additionalProperties": true},
    "warningMessage": {"type": "string"},
    "severity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "continueAllowed": {"type": "boolean"}
  }
}

