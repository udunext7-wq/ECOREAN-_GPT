{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "0.1-project-save",
  "title": "ECOREAN Project Save File",
  "type": "object",
  "required": [
    "projectId",
    "projectName",
    "clientInfo",
    "siteInfo",
    "minimumInput",
    "selectedPreset",
    "selectedProcesses",
    "selectedOptions",
    "generatedEstimate",
    "generatedSchedule",
    "generatedDocuments",
    "paymentPlan",
    "purchaseOrders",
    "dailyReports",
    "inspections",
    "changeOrders",
    "defects",
    "cashflow",
    "caseLibraryLinks",
    "masterDbVersion",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "projectId": {"type": "string"},
    "projectName": {"type": "string"},
    "clientInfo": {"type": "object", "additionalProperties": true},
    "siteInfo": {"type": "object", "additionalProperties": true},
    "minimumInput": {"type": "object", "additionalProperties": true},
    "selectedPreset": {"type": "object", "additionalProperties": true},
    "selectedProcesses": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "selectedOptions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "generatedEstimate": {"type": "object", "additionalProperties": true},
    "generatedSchedule": {"type": "object", "additionalProperties": true},
    "generatedDocuments": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "paymentPlan": {"type": "object", "additionalProperties": true},
    "purchaseOrders": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "dailyReports": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "inspections": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "changeOrders": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "defects": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "cashflow": {"type": "object", "additionalProperties": true},
    "caseLibraryLinks": {"type": "array", "items": {"type": "string"}},
    "masterDbVersion": {"type": "string"},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"}
  },
  "x-ecorean": {
    "exportTargets": ["JSON", "Excel", "PDF", "HTML"],
    "savePurpose": "All project state must be restorable from this file."
  }
}

